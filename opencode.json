{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "agent-lsp": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec direnv exec \"$PWD\" agent-lsp haskell:haskell-language-server-wrapper,lsp nix:nixd"
        ],
        "cwd": ".",
        "timeout": {
          "startup": 180000,
          "catalog": 60000
        }
      }
    }
  }
}
