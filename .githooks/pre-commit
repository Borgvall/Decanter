#!/usr/bin/env runghc

-- |
-- Pre-commit hook for Decanter.
--
-- Wired up in two places:
--
--   1. As a real Git hook (@core.hooksPath@ points at @.githooks@, see the
--      tracked @.gitconfig@ plus the one-time
--      @git config --local include.path ../.gitconfig@ setup described in
--      AGENTS.md / Readme.md), so that EVERY commit is checked.
--   2. From @.claude/hooks/pre-commit-guard.sh@, which is registered as a
--      PreToolUse hook in @.claude/settings.json@ and stops Claude Code
--      from running a @git commit@ Bash command unless this check passes.
--
-- Rules:
--
--   1. @cabal build@ must succeed.
--   2. For every module whose name or path contains "Logic" (e.g.
--      @Bottle.Logic@, @Logic.Translation@, ...), any function that is
--      newly added to its export list (compared to HEAD) must be
--      mentioned at least once in the matching spec module under
--      @test/@ (following the @hspec-discover@ convention, e.g.
--      "Bottle/Logic.hs" -> "test/Bottle/LogicSpec.hs",
--      "Logic/Translation.hs" -> "test/Logic/TranslationSpec.hs").
--      Functions that are not exported (internal helpers) never trigger
--      this check.
--
-- Exit code 0    -> commit is allowed to proceed.
-- Exit code /= 0 -> commit is aborted, error message printed to stderr.
module Main (main) where

import Control.Exception (SomeException, try)
import Control.Monad (unless)
import Data.Char (isAlphaNum)
import Data.List (isInfixOf, isPrefixOf, isSuffixOf, nub, sort, stripPrefix, (\\))
import System.Exit (ExitCode (..), exitFailure, exitSuccess)
import System.IO (hPutStrLn, stderr)
import System.Process
  ( createProcess
  , cwd
  , proc
  , readProcessWithExitCode
  , waitForProcess
  )

-- | A file counts as a "Logic module" if its path contains the substring
-- "Logic" anywhere in its name or directory hierarchy, e.g.
-- "Bottle/Logic.hs" or "Logic/Translation.hs".
isLogicModulePath :: FilePath -> Bool
isLogicModulePath path =
  ".hs" `isSuffixOf` path
    && not ("test/" `isPrefixOf` path)
    && "Logic" `isInfixOf` path

-- | Derives the expected spec file path for a module path, following the
-- @hspec-discover@ convention: "Some/Module.hs" -> "test/Some/ModuleSpec.hs".
specPathFor :: FilePath -> FilePath
specPathFor path = "test/" ++ base ++ "Spec.hs"
 where
  base = case stripSuffix ".hs" path of
    Just b -> b
    Nothing -> path

  stripSuffix suf s
    | suf `isSuffixOf` s = Just (take (length s - length suf) s)
    | otherwise = Nothing

main :: IO ()
main = do
  repoRoot <- gitToplevel

  buildOk <- runCommandLive repoRoot "cabal" ["build", "--enable-tests", "all"]
  unless buildOk $ do
    hPutStrLn stderr ""
    hPutStrLn stderr "\10060 'cabal build' failed. Please fix the build before committing."
    exitFailure

  staged <- stagedFiles repoRoot
  let logicModules = sort (filter isLogicModulePath staged)

  if null logicModules
    then exitSuccess
    else do
      results <- mapM (checkExportedFunctionsCovered repoRoot) logicModules
      if and results then exitSuccess else exitFailure

-- --------------------------------------------------------------------------
-- Git helpers
-- --------------------------------------------------------------------------

gitToplevel :: IO FilePath
gitToplevel = do
  (code, out, _) <- readProcessWithExitCode "git" ["rev-parse", "--show-toplevel"] ""
  pure $ if code == ExitSuccess then trim out else "."

stagedFiles :: FilePath -> IO [String]
stagedFiles root = do
  (code, out, _) <-
    readProcessWithExitCode "git" ["-C", root, "diff", "--cached", "--name-only"] ""
  pure $ if code == ExitSuccess then lines out else []

-- | Contents of a file at a given Git revision (e.g. @"HEAD"@, or the empty
-- string for the index @""@). Returns @""@ if the file does not exist at
-- that revision (e.g. because it is new).
gitShow :: FilePath -> String -> FilePath -> IO String
gitShow root rev path = do
  let ref = rev ++ ":" ++ path
  result <- try (readProcessWithExitCode "git" ["-C", root, "show", ref] "") :: IO (Either SomeException (ExitCode, String, String))
  pure $ case result of
    Right (ExitSuccess, out, _) -> out
    _ -> ""

-- | Runs a command with inherited stdin/stdout/stderr (so e.g. 'cabal
-- build' streams its progress output live) and reports whether it
-- succeeded.
runCommandLive :: FilePath -> String -> [String] -> IO Bool
runCommandLive root cmd args = do
  putStrLn $ "==> [pre-commit] Checking '" ++ unwords (cmd : args) ++ "' ..."
  (_, _, _, ph) <- createProcess (proc cmd args) {cwd = Just root}
  code <- waitForProcess ph
  case code of
    ExitSuccess -> putStrLn "\9989 cabal build succeeded." >> pure True
    ExitFailure _ -> pure False

-- --------------------------------------------------------------------------
-- Test-coverage check for newly exported functions of a Logic module
-- --------------------------------------------------------------------------

checkExportedFunctionsCovered :: FilePath -> FilePath -> IO Bool
checkExportedFunctionsCovered root logicFile = do
  let specFile = specPathFor logicFile

  putStrLn $ "==> [pre-commit] " ++ logicFile ++ " changed, checking test coverage in " ++ specFile ++ " ..."

  oldSrc <- gitShow root "HEAD" logicFile
  newSrc <- gitShow root "" logicFile -- "" == index/staging area

  let oldExports = exportedFunctionNames oldSrc
      newExports = exportedFunctionNames newSrc
      addedExports = sort (newExports \\ oldExports)

  if null addedExports
    then do
      putStrLn $ "\9989 No newly exported functions in " ++ logicFile ++ "."
      pure True
    else do
      putStrLn $ "Newly exported functions in " ++ logicFile ++ ":"
      mapM_ (\f -> putStrLn ("  - " ++ f)) addedExports

      specSrc <- gitShow root "" specFile
      let missing = [f | f <- addedExports, not (f `isSubstringOf` specSrc)]

      if null missing
        then do
          putStrLn $ "\9989 Test coverage for newly exported functions in " ++ specFile ++ " looks good."
          pure True
        else do
          hPutStrLn stderr ""
          hPutStrLn stderr $
            "\10060 Missing test case(s) in " ++ specFile
              ++ " for the following newly exported function(s) from " ++ logicFile ++ ":"
          mapM_ (\f -> hPutStrLn stderr ("   - " ++ f)) missing
          hPutStrLn stderr ""
          hPutStrLn stderr $
            "   Please add at least one 'it \"...\"' test case referencing each"
              ++ " function to " ++ specFile ++ " and commit again."
          pure False

isSubstringOf :: String -> String -> Bool
isSubstringOf needle haystack = any (needle `isPrefixOf`) (tails' haystack)
 where
  tails' [] = [[]]
  tails' s@(_ : rest) = s : tails' rest

-- --------------------------------------------------------------------------
-- Minimal parser for a Haskell module's export list
-- --------------------------------------------------------------------------

-- | Extracts the names of all *functions* (not types/constructors/classes)
-- exported from the module header. Following Haskell convention, function
-- names start with a lowercase letter or an underscore; types, data and
-- constructors start with an uppercase letter (e.g. @NameValid(Valid)@ is
-- ignored).
exportedFunctionNames :: String -> [String]
exportedFunctionNames src =
  case extractExportList (stripLineComments src) of
    Nothing -> []
    Just exportBlock ->
      sort . nub . filter isFunctionName . map identifierOf $ splitTopLevel ',' exportBlock

-- | Strips single-line Haskell comments ("-- ...") from the source so they
-- don't pollute the export list (e.g. section headers like
-- "-- * Validation").
stripLineComments :: String -> String
stripLineComments = unlines . map stripLine . lines
 where
  stripLine line = case breakOn "--" line of
    (before, _) -> before

  breakOn :: String -> String -> (String, String)
  breakOn pat s = go "" s
   where
    go acc rest
      | pat `isPrefixOf` rest = (reverse acc, rest)
      | null rest = (reverse acc, "")
      | otherwise = go (head rest : acc) (tail rest)

-- | Finds "module", then the first opening parenthesis, and returns the
-- text up to the matching (balanced) closing parenthesis.
extractExportList :: String -> Maybe String
extractExportList src = do
  afterModule <- stripPrefix "module" =<< dropToSubstring "module" src
  afterOpen <- dropToChar '(' afterModule
  takeBalanced 1 (tail afterOpen) ""
 where
  dropToSubstring pat s
    | pat `isPrefixOf` s = Just s
    | null s = Nothing
    | otherwise = dropToSubstring pat (tail s)

  dropToChar c s
    | null s = Nothing
    | head s == c = Just s
    | otherwise = dropToChar c (tail s)

  takeBalanced :: Int -> String -> String -> Maybe String
  takeBalanced depth remaining acc
    | depth == 0 = Just (reverse acc)
    | null remaining = Nothing
    | head remaining == '(' = takeBalanced (depth + 1) (tail remaining) (head remaining : acc)
    | head remaining == ')' =
        if depth == 1
          then Just (reverse acc)
          else takeBalanced (depth - 1) (tail remaining) (head remaining : acc)
    | otherwise = takeBalanced depth (tail remaining) (head remaining : acc)

-- | Splits a string on commas that are NOT nested inside parentheses (e.g.
-- for @Type(CtorA, CtorB)@).
splitTopLevel :: Char -> String -> [String]
splitTopLevel sep = go 0 "" []
 where
  go :: Int -> String -> [String] -> String -> [String]
  go _ cur acc [] = reverse (reverse cur : acc)
  go depth cur acc (c : cs)
    | c == '(' = go (depth + 1) (c : cur) acc cs
    | c == ')' = go (depth - 1) (c : cur) acc cs
    | c == sep && depth == 0 = go depth "" (reverse cur : acc) cs
    | otherwise = go depth (c : cur) acc cs

-- | Extracts the leading identifier (letters, digits, @_@, @'@) from a
-- trimmed export item.
identifierOf :: String -> String
identifierOf item = takeWhile isIdentChar (trim item)
 where
  isIdentChar c = isAlphaNum c || c == '_' || c == '\''

isFunctionName :: String -> Bool
isFunctionName name = case name of
  (c : _) -> c == '_' || (c >= 'a' && c <= 'z')
  [] -> False

trim :: String -> String
trim = f . f
 where
  f = reverse . dropWhile (`elem` (" \t\n\r" :: String))
