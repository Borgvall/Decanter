{
  "mcpServers": {
    "agent-lsp": {
      "type": "stdio",
      "command": "agent-lsp",
      "args": ["haskell:haskell-language-server-wrapper,lsp"]
    },
    "github": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) exec github-mcp-server stdio"]
    }
  }
}
